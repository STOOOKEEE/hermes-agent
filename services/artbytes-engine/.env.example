# --- RPC ---
ETH_RPC_URL=
BASE_RPC_URL=

# --- APIs (read) ---
OPENSEA_API_KEY=
# Preferred on servers: keep the key in a chmod-600 file instead of .env.
OPENSEA_API_KEY_FILE=
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# --- Wallets (private key files on the VM, chmod 600 — never the key itself here) ---
WALLET_RAID_PK_FILE=/home/hermes/.hermes/secrets/wallet_raid_pk
WALLET_KRYSKO_PK_FILE=/home/hermes/.hermes/secrets/wallet_krysko_pk

# --- Gas (technical guards; per-mint spend budgets are set by the AI in the order) ---
MAX_GAS_ETH=0.01             # absolute gas ceiling per TX (anti gas-war)
MAX_PRIORITY_GWEI=1.5        # EIP-1559 maxPriorityFeePerGas
BASEFEE_MULT=2               # maxFeePerGas = baseFee * BASEFEE_MULT + priority

# --- Approval ---
AUTO_APPROVE=false           # global kill-switch; per-mint opt-in only (decision='max')
APPROVAL_TIMEOUT_MS=7200000  # 2h with no human reply -> cancelled (capital-first)

# --- Telegram (reuse the Hermes channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# --- Optional AI advice (codex gateway) ---
GATEWAY_URL=http://localhost:8742/v1/complete

# --- Control API (bound to 127.0.0.1 only) ---
CONTROL_PORT=8743
CONTROL_TOKEN=

# --- App ---
DB_PATH=./data/engine.db
LOG_LEVEL=info
MONITOR_TICK_MS=60000
