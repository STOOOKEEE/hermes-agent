# Copiez uniquement les noms nécessaires dans ~/.hermes/.env sur le serveur.
# Ne remplissez et ne commitez jamais ce fichier d’exemple.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_HOME_CHANNEL=

# Valeurs sûres recommandées pour un bot personnel.
DISCORD_ALLOW_ALL_USERS=false
DISCORD_REQUIRE_MENTION=true
DISCORD_ALLOW_BOTS=none
